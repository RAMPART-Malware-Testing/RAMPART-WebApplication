# SERVER_URL is used by the web server only (internal address of the API).
SERVER_URL=http://localhost:8006

# Public HTTPS origin of the API, used by the browser: the /scan page uploads
# files straight to it. Must be reachable from the user's browser and must allow
# this app's origin in its CORS config. Leave empty to fall back to SERVER_URL
# (useful on localhost).
SERVER_URL_HTTPS=https://rm-api.mon-kai.com

# Public origin of this app. Used for OAuth redirect URIs and every redirect
# the app issues, so on deploy it must be the public URL (e.g.
# https://app.example.com) and must match what is registered with Google/GitHub.
# When it is empty the origin is derived from the request (x-forwarded-host).
APP_URL=http://localhost:3000

# Optional exact redirect URIs. Set these when the callback host differs from
# APP_URL or when the provider registration uses a different path. When empty,
# the value is APP_URL + /api/auth/<provider>/callback.
# GOOGLE_REDIRECT_URI=https://app.example.com/api/auth/google/callback
# GITHUB_REDIRECT_URI=https://app.example.com/api/auth/github/callback

# Signs the session cookie this app reads. Must be set, and must differ from
# every other secret in this file.
JWT_SECRET=changeme

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=changeme
RECAPTCHA_SECRET_KEY=changeme

GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# GitHub login is disabled (ENABLED_PROVIDERS in src/lib/oauth-providers.ts).
# Leave these empty until it is enabled again.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The trust boundary between this app and the API server: must be byte-identical
# to OAUTH_BRIDGE_SECRET in RAMPART-API-SERVERv1/.env, and kept out of git.
OAUTH_BRIDGE_SECRET=changeme

# NODE_ENV is not set here - next dev/next build/next start and the hosting
# platform each set it themselves.
